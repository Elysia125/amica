{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "macOS": {
      "entitlements": "Release.entitlements",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "amica",
  "mainBinaryName": "amica",
  "version": "0.2.1",
  "identifier": "com.heyamica.dev",
  "plugins": {},
  "app": {
    "windows": [
      {
        "width": 800,
        "height": 600,
        "fullscreen": false,
        "resizable": true,
        "title": "Amica",
        "transparent": true,
        "visible": false,
        "label": "main",
        "useHttpsScheme": true
      },
      {
        "fullscreen": false,
        "transparent": true,
        "resizable": false,
        "width": 400,
        "height": 215,
        "decorations": false,
        "url": "/splashscreen.html",
        "label": "splashscreen",
        "useHttpsScheme": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  }
}